          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/admin/wallets/limit-bounds",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "admin",
            "wallets",
            "limit-bounds"
          ]
        }
      },
      "response": []
    },
