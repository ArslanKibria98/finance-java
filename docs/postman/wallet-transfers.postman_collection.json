    {
      "name": "🔍 Ledger Proxy — Direct Verification (no JWT)",
      "description": "Direct calls to the ledger-service Fineract proxy. These are the same endpoints wallet-service calls under the hood. Use them to verify the single-bridge architecture and inspect Fineract state without touching wallet-service.\n\n**No JWT required** — internal endpoints expect `X-Tenant-Id` + `X-Caller-Service` headers.",
      "item": [
        {
          "name": "P1. Get Fineract savings A directly via ledger proxy",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('200 OK', () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "const d = r.data || r;",
                  "console.log('Fineract savings', d.id, '| status:', d.status?.value, '| balance:', d.summary?.accountBalance, '| available:', d.summary?.availableBalance);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" },
              { "key": "X-Caller-Service", "value": "postman-verification" },
              { "key": "X-Correlation-ID", "value": "postman-{{$timestamp}}" }
            ],
            "url": "{{ledgerInternalUrl}}/internal/fineract-proxy/savings/accounts/{{savingsA}}",
            "description": "Direct call to the ledger proxy. Audit row written to fineract_audit_log with caller_service='postman-verification'."
          }
        },
        {
          "name": "P2. Get Fineract savings B directly via ledger proxy",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [
              { "key": "X-Tenant-Id", "value": "{{tenantId}}" },
              { "key": "X-Caller-Service", "value": "postman-verification" }
            ],
