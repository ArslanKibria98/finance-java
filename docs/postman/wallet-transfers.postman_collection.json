          "raw": "{{baseUrl}}/api/v1/wallets/transfers/recipient?mobile={{mobileB}}",
          "host": ["{{baseUrl}}"],
          "path": ["api", "v1", "wallets", "transfers", "recipient"],
          "query": [{ "key": "mobile", "value": "{{mobileB}}" }]
        },
        "description": "Verify recipient name + wallet status BEFORE confirming the transfer in UI.\nReturns: {found, walletId, walletNumber, maskedName, maskedMobile, currency, walletStatus, canReceive}"
      }
    },
    {
      "name": "3.1 🆕 Get Recent Recipients (Last 5)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const d = pm.response.json();",
              "pm.test('Is array', () => pm.expect(Array.isArray(d)).to.be.true);",
              "if (d.length > 0) {",
              "    console.log('Recent Recipients count:', d.length);",
              "    console.log('Last recipient:', d[0].maskedName, '(', d[0].walletNumber, ')');",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/v1/wallets/transfers/recent-recipients",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "wallets",
            "transfers",
            "recent-recipients"
          ]
        },
        "description": "Returns the last 5 unique destination accounts (wallets) the customer has sent money to, resolved from the customer's JWT."
      },
      "response": []
    },
    {
      "name": "4. ✅ Transfer by mobile — A → B (250 SAR) [Fineract via proxy]",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const resp = pm.response.json();",
              "const d = resp.data || resp;",
              "pm.collectionVariables.set('lastTransferId', d.id);",
              "pm.test('status COMPLETED', () => pm.expect(d.status).to.eql('COMPLETED'));",
              "pm.test('amount=250', () => pm.expect(parseFloat(d.amount)).to.eql(250));",
              "console.log('Transfer:', d.transferNumber, '| status:', d.status);",
              "console.log('Audit log: 2x savings.account.get + 1x savings.account.transfer rows in ledger_db.fineract_audit_log');"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-Idempotency-Key", "value": "{{$guid}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"receiverMobile\": \"{{mobileB}}\",\n  \"amount\": 250.00,\n  \"currency\": \"SAR\",\n  \"purposeNote\": \"P2P via mobile (routed through ledger-service)\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/wallets/transfers/by-mobile",
        "description": "Sender wallet resolved from JWT (sub → identity-service → customerId → wallet).\nReceiver wallet resolved from receiverMobile.\nNo wallet IDs in request body.\n\n**Path:** wallet-service → ledger proxy → Fineract /accounttransfers (atomic)."
      }
    },
