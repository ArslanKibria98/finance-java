          "raw": "{\n  \"sourceWalletId\": \"{{walletA}}\",\n  \"destinationWalletId\": \"{{walletB}}\",\n  \"amount\": 1000.00,\n  \"currency\": \"SAR\",\n  \"purposeNote\": \"Lunch repayment\",\n  \"channel\": \"P2P_WALLET_ID\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/wallets/transfers"
      }
    },
