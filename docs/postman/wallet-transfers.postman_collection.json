      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "const d = body.data || body;",
              "console.log('My wallet:', d.walletNumber, '| Balance:', d.availableBalance, d.currency);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/wallets/me/balance",
        "description": "NEW — resolves wallet from JWT customer_id/sub. No walletId in URL. Fineract balance fetched live via FineractSavingsPort."
      }
    },
    {
      "name": "2. Balance — Wallet B (BEFORE) [proxied via ledger-service]",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/v1/wallets/{{walletB}}/balance"
      }
    },
    {
      "name": "3. ✅ Lookup recipient by mobile (verify name)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const d = pm.response.json().data;",
              "pm.test('found', () => pm.expect(d.found).to.be.true);",
              "pm.test('canReceive', () => pm.expect(d.canReceive).to.be.true);",
              "console.log('Recipient:', d.maskedName, '|', d.maskedMobile, '|', d.walletStatus);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
