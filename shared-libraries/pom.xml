<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.3.7</version>
        <relativePath/>
    </parent>

    <groupId>com.ksa.islamic.finance</groupId>
    <artifactId>shared-libraries</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>
    <name>Islamic Finance Platform - Shared Libraries</name>
    <description>Shared SDK libraries for Islamic Finance Platform</description>

    <properties>
        <java.version>21</java.version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <modules>
        <module>foundational-infra-sdk</module>
        <module>domain-core-sdk</module>
        <module>workflow-orchestration-sdk</module>
        <module>lms-adapter-sdk</module>
        <module>compliance-localization-sdk</module>
        <module>reporting-projection-sdk</module>
        <module>test-harness-sdk</module>
        <module>messaging-event-sdk</module>
        <module>kyc-activity-api</module>
        <module>customer-activity-api</module>
        <module>wallet-activity-api</module>
        <module>identity-activity-api</module>
        <module>notification-activity-api</module>
        <module>risk-activity-api</module>
        <module>lending-activity-api</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Cloud -->
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>2023.0.5</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!-- Internal SDKs -->
            <dependency>
                <groupId>com.ksa.islamic.finance</groupId>
                <artifactId>foundational-infra-sdk</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ksa.islamic.finance</groupId>
                <artifactId>domain-core-sdk</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ksa.islamic.finance</groupId>
                <artifactId>workflow-orchestration-sdk</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ksa.islamic.finance</groupId>
                <artifactId>lms-adapter-sdk</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ksa.islamic.finance</groupId>
                <artifactId>compliance-localization-sdk</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ksa.islamic.finance</groupId>
                <artifactId>reporting-projection-sdk</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ksa.islamic.finance</groupId>
                <artifactId>test-harness-sdk</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ksa.islamic.finance</groupId>
                <artifactId>messaging-event-sdk</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ksa.islamic.finance</groupId>
                <artifactId>kyc-activity-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ksa.islamic.finance</groupId>
                <artifactId>customer-activity-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ksa.islamic.finance</groupId>
                <artifactId>wallet-activity-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ksa.islamic.finance</groupId>
                <artifactId>identity-activity-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ksa.islamic.finance</groupId>
                <artifactId>notification-activity-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.ksa.islamic.finance</groupId>
                <artifactId>risk-activity-api</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.15.0</version>
                    <configuration>
                        <source>21</source>
                        <target>21</target>
                        <encoding>UTF-8</encoding>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>