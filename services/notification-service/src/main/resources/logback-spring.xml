<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Shared base: JSON console + Logstash TCP appender + dedicated api-audit logger -->
    <include resource="logback-ksa-base.xml"/>

    <root level="${LOG_LEVEL:-INFO}">
        <appender-ref ref="KSA_JSON_CONSOLE"/>
        <appender-ref ref="KSA_ASYNC_LOGSTASH"/>
    </root>
    <logger name="com.ksa.financing" level="${APP_LOG_LEVEL:-INFO}"/>
</configuration>
