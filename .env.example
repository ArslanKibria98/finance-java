# KSA Islamic Financing Platform - Environment Variables
# Copy this file to .env and adjust values as needed

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ksa_financing
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_SCHEMA_REGISTRY_URL=http://localhost:8081

# Temporal Configuration
TEMPORAL_HOST=localhost
TEMPORAL_PORT=7233
TEMPORAL_NAMESPACE=default

# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=ksa-financing
KEYCLOAK_CLIENT_ID=ksa-financing-client
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Elasticsearch Configuration
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_INDEX_PREFIX=ksa-financing

# Logstash Configuration
LOGSTASH_HOST=localhost
LOGSTASH_PORT=5000

# Kibana Configuration
KIBANA_URL=http://localhost:5601

# Prometheus Configuration
PROMETHEUS_URL=http://localhost:9090

# Grafana Configuration
GRAFANA_URL=http://localhost:3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# Jaeger Configuration
JAEGER_URL=http://localhost:16686
JAEGER_COLLECTOR_URL=http://localhost:14268

# Fineract Configuration
FINERACT_URL=https://localhost:8443
FINERACT_TENANT=default

# Application Configuration
SPRING_PROFILES_ACTIVE=local
LOG_LEVEL=INFO

# Monitoring
MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=health,info,metrics,prometheus
MANAGEMENT_METRICS_EXPORT_PROMETHEUS_ENABLED=true
